      }
    }
  },
  "variables": {
    "govEngineUrlParts": "[parseUri(parameters('govEngineUrl'))]",
    "govEngineAudienceParts": "[parseUri(parameters('govEngineAudience'))]",
    "hostnameAlphanumeric": "abcdefghijklmnopqrstuvwxyz0123456789",
    "hostnameCharacters": "[format('{0}-', variables('hostnameAlphanumeric'))]",
    "invalidGovEngineUrlHostCharacters": "[filter(range(0, length(variables('govEngineUrlParts').host)), lambda('index', not(contains(format('{0}.', variables('hostnameCharacters')), substring(toLower(variables('govEngineUrlParts').host), lambdaVariables('index'), 1)))))]",
