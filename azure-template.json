    "invalidGovEngineAudienceHostLabels": "[filter(split(toLower(variables('govEngineAudienceParts').host), '.'), lambda('label', or(or(or(empty(lambdaVariables('label')), greater(length(lambdaVariables('label')), 63)), not(contains(variables('hostnameAlphanumeric'), first(lambdaVariables('label'))))), not(contains(variables('hostnameAlphanumeric'), last(lambdaVariables('label')))))))]",
    "validGovEngineUrl": "[and(and(and(and(and(and(equals(variables('govEngineUrlParts').scheme, 'https'), not(empty(variables('govEngineUrlParts').host))), equals(length(variables('invalidGovEngineUrlHostCharacters')), 0)), equals(length(variables('invalidGovEngineUrlHostLabels')), 0)), empty(variables('govEngineUrlParts').query)), or(empty(variables('govEngineUrlParts').path), equals(variables('govEngineUrlParts').path, '/'))), equals(buildUri(variables('govEngineUrlParts')), parameters('govEngineUrl')))]",
